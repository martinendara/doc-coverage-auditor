# ---- Qué modelo usa el agente -------------------------------------------
# local | anthropic | openai
LLM_PROVIDER=local

# local | openai   (Anthropic NO tiene API de embeddings)
EMBEDDINGS_PROVIDER=local

# ---- LM Studio (servidor local, compatible con OpenAI) ------------------
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_CHAT_MODEL=qwen/qwen3-8b
LOCAL_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
LOCAL_API_KEY=lm-studio

# ---- Cloud ---------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Retrieval -----------------------------------------------------------
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=4
